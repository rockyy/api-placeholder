{
  "dynamic-form": {
    "page": "contact-us",
    "schemaVersion": "1",
    "active": true,
    "dataSources": [],
    "schemaJson": {
      "formId": "contact_us",
      "title": "Contact Us",
      "subTitle": "We usually reply within one business day",
      "sections": [
        {
          "sectionId": "yourDetails",
          "title": "YOUR DETAILS",
          "expandable": false,
          "sequence": 1,
          "fields": [
            {
              "fieldId": "fullName",
              "label": "Full Name",
              "type": "TEXT",
              "editable": true,
              "required": true,
              "enforceMaxLength": true,
              "placeholder": "Enter your full name",
              "sanitization": {
                "type": "NAME",
                "pattern": "^[\\p{L} ']*$",
                "message": "Only alphabets, spaces and apostrophe (') are allowed"
              },
              "validationRules": [
                {
                  "type": "required",
                  "message": "Please enter your name"
                },
                {
                  "type": "maxLength",
                  "value": 60,
                  "message": "Name can't exceed 60 characters"
                }
              ],
              "sequence": 1
            },
            {
              "fieldId": "email",
              "label": "Email",
              "type": "EMAIL",
              "editable": true,
              "required": true,
              "placeholder": "you@example.com",
              "helperText": "We'll send our reply here",
              "validationRules": [
                {
                  "type": "required",
                  "message": "Email is required"
                },
                {
                  "type": "email",
                  "message": "Enter a valid email address"
                }
              ],
              "sequence": 2
            },
            {
              "fieldId": "phone",
              "label": "Phone (optional)",
              "type": "PHONE",
              "editable": true,
              "required": false,
              "validationRules": [
                {
                  "type": "pattern",
                  "value": "^[0-9+ \\-]{7,15}$",
                  "message": "Enter a valid phone number"
                }
              ],
              "sequence": 3
            }
          ]
        },
        {
          "sectionId": "message",
          "title": "YOUR MESSAGE",
          "expandable": false,
          "sequence": 2,
          "fields": [
            {
              "fieldId": "topic",
              "label": "Topic",
              "type": "DROPDOWN",
              "editable": true,
              "required": true,
              "requiresOtherInput": true,
              "otherInput": {
                "triggerValue": "Others",
                "label": "Please specify your topic",
                "placeholder": "Tell us what it's about",
                "required": true,
                "validationRules": [
                  {
                    "type": "maxLength",
                    "value": 50,
                    "message": "Keep it under 50 characters"
                  }
                ]
              },
              "options": [
                "General enquiry",
                "Order issue",
                "Feedback",
                "Others"
              ],
              "optionsLabel": "What is your message about?",
              "validationRules": [
                {
                  "type": "required",
                  "message": "Please pick a topic"
                }
              ],
              "sequence": 1
            },
            {
              "fieldId": "orderId",
              "label": "Order ID",
              "type": "TEXT",
              "editable": true,
              "required": true,
              "placeholder": "e.g. ORD-12345",
              "helperText": "Found in your order confirmation email",
              "visibilityRules": [
                {
                  "fieldId": "topic",
                  "operator": "EQUALS",
                  "value": "Order issue"
                }
              ],
              "validationRules": [
                {
                  "type": "required",
                  "message": "Order ID is required for order issues"
                }
              ],
              "sequence": 2
            },
            {
              "fieldId": "messageBody",
              "label": "Message",
              "type": "TEXTAREA",
              "editable": true,
              "required": true,
              "placeholder": "How can we help?",
              "validationRules": [
                {
                  "type": "required",
                  "message": "Message is required"
                },
                {
                  "type": "minLength",
                  "value": 20,
                  "message": "Please give us a bit more detail (at least 20 characters)"
                },
                {
                  "type": "maxLength",
                  "value": 500,
                  "message": "Max 500 characters are allowed"
                }
              ],
              "sequence": 3
            },
            {
              "fieldId": "contactConsent",
              "label": "Consent",
              "type": "CONSENT",
              "editable": true,
              "required": true,
              "consentText": "I agree to be contacted about this request and accept the privacy policy.",
              "validationRules": [
                {
                  "type": "required",
                  "message": "Please accept to continue"
                }
              ],
              "sequence": 4
            }
          ]
        }
      ]
    }
  }
}
