  B --> C["Store accessToken, journeyId, txnRef, publicKey"]
  C --> D["App calls backend service"]
  D --> E["AxiosHttpClient"]
  E --> F{"Encryption flag on and not init?"}
  F -- "No" --> G["Send normal JSON"]
  F -- "Yes" --> H["Encrypt body with AES-GCM"]
  H --> I["Encrypt AES key with RSA publicKey"]
